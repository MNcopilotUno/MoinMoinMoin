{
  "name": "moin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "pnpm --filter @moin/moin-moin-moin build && pnpm --filter @moin/moin-domi build && node scripts/assemble-site.mjs",
    "test": "pnpm -r --filter \"./packages/**\" test",
    "test:e2e": "pnpm --filter @moin/moin-moin-moin test:e2e && pnpm --filter @moin/moin-domi test:e2e",
    "test:offline": "pnpm --filter @moin/moin-moin-moin test:offline",
    "validate:levels": "pnpm --filter @moin/levels validate",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "10.13.0",
    "globals": "^17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
