{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moin.local/level.schema.json",
  "title": "Level",
  "description": "A Moin Moin Moin level, formatVersion 1.x (CLAUDE.md §6). Chatterboxes need 1.1.0 or later.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "title", "width", "height", "cells", "par"],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" },
    "id": { "type": "string", "pattern": "^[a-z]+(-\\d+)+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 40 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "cells": { "type": "array", "items": { "$ref": "#/definitions/cell" } },
    "par": { "type": "integer", "minimum": 1, "description": "Must equal the solver's optimum." }
  },
  "definitions": {
    "facing": { "type": "string", "enum": ["N", "E", "S", "W"] },
    "cell": {
      "type": "object",
      "required": ["kind"],
      "discriminator": { "propertyName": "kind" },
      "oneOf": [
        { "$ref": "#/definitions/person" },
        { "$ref": "#/definitions/seagull" },
        { "$ref": "#/definitions/fender" }
      ]
    },
    "person": {
      "title": "PersonCell",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "kind", "facing", "needs"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "kind": { "const": "person" },
        "facing": { "$ref": "#/definitions/facing" },
        "needs": { "type": "integer", "enum": [1, 2] },
        "role": { "type": "string", "enum": ["fisherman", "captain", "market", "kid"] },
        "chatterbox": { "type": "boolean", "description": "R13: their Moin carries two greetings. Needs formatVersion 1.1.0 or later." }
      }
    },
    "seagull": {
      "title": "SeagullCell",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "kind"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "kind": { "const": "seagull" }
      }
    },
    "fender": {
      "title": "FenderCell",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "kind", "slant"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "kind": { "const": "fender" },
        "slant": { "type": "string", "enum": ["rising", "falling"] }
      }
    }
  }
}
